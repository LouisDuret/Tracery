        "R07": 3.0, "R08": 3.0, "R09": 1.0, "R10": 0.0, "R11": 0.0, "R12": 0.0,
        "R14": 0.0, "R15": 0.5, "R16": 3.0, "R17": 1.0, "R19": 1.5, "R20": 2.0, "R21": 1.0, "R22": 0.0, "R23": 0.0, "R24": 0.0, "R25": 0.0,
    },
    score: {
        "dens": 1.0, "meneau": 1.5, "vide": 1.0, "tan": 1.0, "sym": 0.8,
        "hier": 0.7, "prop": 0.5, "equil": 0.6, "compl": 0.4, "coher": 0.4,
