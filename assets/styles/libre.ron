// Style « libre » : poids des règles (0 = exclue), symétrie, brisure, score.
// Modifiable sans recompiler les règles (rechargé à la compilation).
(
    name: "libre",
    symmetry: free,
    rho: 1.0,
    rho_range: (0.6, 1.3),
    twin_prob: 0.5,
    cusping: 0.5,
    rules: {
        "R01": 1.5, "R02": 1.5, "R03": 1.5, "R04": 1.5, "R05": 1.5, "R06": 1.5,
        "R07": 1.5, "R08": 1.5, "R09": 1.5, "R10": 1.5, "R11": 1.5, "R12": 1.5,
        "R14": 1.0, "R15": 0.8, "R16": 1.5, "R17": 1.0, "R19": 0.6, "R20": 1.5, "R21": 1.5, "R22": 2.0, "R23": 1.5, "R24": 1.5, "R25": 1.5,
    },
    score: {
        "dens": 1.0, "meneau": 1.5, "vide": 1.0, "tan": 1.0, "sym": 0.3,
        "hier": 0.7, "prop": 0.5, "equil": 0.6, "compl": 0.4, "coher": 0.4,
    },
)
